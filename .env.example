PORT=4000

DB_USER=test
DB_PASSWORD=test
DB_NAME=testdb
DB_HOST=db
DB_PORT=5432

# URL for connection to PostgreSQL
DATABASE_URL=postgresql://test:test@db:5432/testdb?schema=public

# maximum log file size before rotation in kBs
LOG_MAX_SIZE_KB=1

# logging level (0-log, 1-fatal, 2-error, 3-warn, 4-debug, 5-verbose)
LOG_LEVEL=2

# error logging file
ERROR_LOG_FILE=logs/errors.log

# all logs logging file
INFO_LOG_FILE=logs/app.log

JWT_SECRET=secret123
REFRESH_TOKEN_SECRET=secret456
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=24h
JWT_SECRET_REFRESH_KEY=secret456
