generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid())
  login     String @unique
  password  String
  version   Int    @default(1)
  createdAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@map("user")
}

model Artist {
  id     String  @id @default(uuid())
  name   String
  grammy Boolean

  @@map("artist")
}

model Album {
  id       String  @id @default(uuid())
  name     String
  year     Int
  artistId String?

  @@map("album")
}

model Track {
  id       String  @id @default(uuid())
  name     String
  artistId String?
  albumId  String?
  duration Int

  @@map("track")
}

model Favorites {
  id      String   @id @default(uuid())
  artists String[]
  albums  String[]
  tracks  String[]

  @@map("favorites")
}
